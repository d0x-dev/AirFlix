+package com.brentvatne.exoplayer;
+
+import android.net.Uri;
+
+import androidx.annotation.Nullable;
+import androidx.media3.common.C;
+import androidx.media3.datasource.DataSource;
+import androidx.media3.datasource.DataSpec;
+import androidx.media3.datasource.TransferListener;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Makes Matroska files with a chained SeekHead seekable by Media3.
+ *
+ * <p>Media3 follows a Cues entry from the first SeekHead, but it does not follow a SeekHead entry
+ * that points to a second SeekHead. Some versions of mkvmerge write the Cues entry only in that
+ * second SeekHead. This wrapper discovers the chained entry with two small range reads and
+ * rewrites the bytes exposed to Media3 so the first entry points directly to Cues. The source file
+ * and remote response are never modified.
+ */
+final class ChainedMatroskaDataSource implements DataSource {
+    private static final int PROBE_LENGTH = 128 * 1024;
+    private static final int SEEK_ENTRY_SCAN_LENGTH = 96;
+
+    private static final byte[] SEGMENT_ID = bytes(0x18, 0x53, 0x80, 0x67);
+    private static final byte[] SEEK_ID_FOR_SEEK_HEAD =
+            bytes(0x53, 0xAB, 0x84, 0x11, 0x4D, 0x9B, 0x74);
+    private static final byte[] SEEK_ID_FOR_CUES =
+            bytes(0x53, 0xAB, 0x84, 0x1C, 0x53, 0xBB, 0x6B);
+    private static final byte[] SEEK_POSITION_ID = bytes(0x53, 0xAC);
+    private static final byte[] CUES_ID = bytes(0x1C, 0x53, 0xBB, 0x6B);
+
+    private static final Patch NO_PATCH = new Patch(-1, null, -1, null);
+    private static final Map<String, Patch> PATCH_CACHE = new ConcurrentHashMap<>();
+
+    private final DataSource.Factory upstreamFactory;
+    private final DataSource upstream;
+
+    private Patch patch = NO_PATCH;
+    private long readPosition;
+
+    private ChainedMatroskaDataSource(DataSource.Factory upstreamFactory) {
+        this.upstreamFactory = upstreamFactory;
+        this.upstream = upstreamFactory.createDataSource();
+    }
+
+    @Override
+    public void addTransferListener(TransferListener transferListener) {
+        upstream.addTransferListener(transferListener);
+    }
+
+    @Override
+    public long open(DataSpec dataSpec) throws IOException {
+        readPosition = dataSpec.position;
+        patch = isMatroska(dataSpec.uri) ? getPatch(dataSpec) : NO_PATCH;
+        return upstream.open(dataSpec);
+    }
+
+    @Override
+    public int read(byte[] buffer, int offset, int length) throws IOException {
+        int bytesRead = upstream.read(buffer, offset, length);
+        if (bytesRead == C.RESULT_END_OF_INPUT) {
+            return bytesRead;
+        }
+
+        applyPatch(buffer, offset, bytesRead, readPosition, patch.seekIdOffset, patch.seekIdBytes);
+        applyPatch(
+                buffer,
+                offset,
+                bytesRead,
+                readPosition,
+                patch.seekPositionOffset,
+                patch.seekPositionBytes);
+        readPosition += bytesRead;
+        return bytesRead;
+    }
+
+    @Nullable
+    @Override
+    public Uri getUri() {
+        return upstream.getUri();
+    }
+
+    @Override
+    public Map<String, List<String>> getResponseHeaders() {
+        return upstream.getResponseHeaders();
+    }
+
+    @Override
+    public void close() throws IOException {
+        try {
+            upstream.close();
+        } finally {
+            patch = NO_PATCH;
+            readPosition = 0;
+        }
+    }
+
+    private Patch getPatch(DataSpec sourceSpec) {
+        String cacheKey = sourceSpec.uri.toString();
+        Patch cached = PATCH_CACHE.get(cacheKey);
+        if (cached != null) {
+            return cached;
+        }
+
+        Patch discovered;
+        try {
+            discovered = discoverPatch(sourceSpec);
+        } catch (Exception ignored) {
+            discovered = NO_PATCH;
+        }
+        PATCH_CACHE.put(cacheKey, discovered);
+        return discovered;
+    }
+
+    private Patch discoverPatch(DataSpec sourceSpec) throws IOException {
+        byte[] header = readRange(sourceSpec, 0, PROBE_LENGTH);
+        int segmentIdOffset = indexOf(header, SEGMENT_ID, 0, header.length);
+        if (segmentIdOffset < 0) {
+            return NO_PATCH;
+        }
+
+        int segmentSizeOffset = segmentIdOffset + SEGMENT_ID.length;
+        int segmentSizeLength = vintLength(header, segmentSizeOffset);
+        if (segmentSizeLength < 1) {
+            return NO_PATCH;
+        }
+        long segmentContentOffset = segmentSizeOffset + segmentSizeLength;
+
+        int chainedSeekIdOffset = indexOf(header, SEEK_ID_FOR_SEEK_HEAD, 0, header.length);
+        if (chainedSeekIdOffset < 0) {
+            return NO_PATCH;
+        }
+
+        UnsignedElement chainedPosition = findUnsignedElement(
+                header,
+                chainedSeekIdOffset + SEEK_ID_FOR_SEEK_HEAD.length,
+                Math.min(header.length, chainedSeekIdOffset + SEEK_ENTRY_SCAN_LENGTH),
+                SEEK_POSITION_ID);
+        if (chainedPosition == null) {
+            return NO_PATCH;
+        }
+
+        long chainedSeekHeadOffset = segmentContentOffset + chainedPosition.value;
+        byte[] chainedSeekHead = readRange(sourceSpec, chainedSeekHeadOffset, PROBE_LENGTH);
+        int cuesSeekIdOffset = indexOf(
+                chainedSeekHead,
+                SEEK_ID_FOR_CUES,
+                0,
+                chainedSeekHead.length);
+        if (cuesSeekIdOffset < 0) {
+            return NO_PATCH;
+        }
+
+        UnsignedElement cuesPosition = findUnsignedElement(
+                chainedSeekHead,
+                cuesSeekIdOffset + SEEK_ID_FOR_CUES.length,
+                Math.min(chainedSeekHead.length, cuesSeekIdOffset + SEEK_ENTRY_SCAN_LENGTH),
+                SEEK_POSITION_ID);
+        if (cuesPosition == null || !fitsUnsigned(cuesPosition.value, chainedPosition.payloadLength)) {
+            return NO_PATCH;
+        }
+
+        long seekIdPayloadOffset = chainedSeekIdOffset + 3L;
+        return new Patch(
+                seekIdPayloadOffset,
+                CUES_ID,
+                chainedPosition.payloadOffset,
+                encodeUnsigned(cuesPosition.value, chainedPosition.payloadLength));
+    }
+
+    private byte[] readRange(DataSpec sourceSpec, long position, int requestedLength)
+            throws IOException {
+        DataSource probe = upstreamFactory.createDataSource();
+        ByteArrayOutputStream output = new ByteArrayOutputStream(requestedLength);
+        try {
+            DataSpec probeSpec = sourceSpec.buildUpon()
+                    .setPosition(position)
+                    .setLength(requestedLength)
+                    .build();
+            probe.open(probeSpec);
+            byte[] chunk = new byte[8192];
+            int remaining = requestedLength;
+            while (remaining > 0) {
+                int count = probe.read(chunk, 0, Math.min(chunk.length, remaining));
+                if (count == C.RESULT_END_OF_INPUT) {
+                    break;
+                }
+                output.write(chunk, 0, count);
+                remaining -= count;
+            }
+        } finally {
+            probe.close();
+        }
+        return output.toByteArray();
+    }
+
+    @Nullable
+    private static UnsignedElement findUnsignedElement(
+            byte[] data,
+            int start,
+            int end,
+            byte[] elementId) {
+        int idOffset = indexOf(data, elementId, start, end);
+        if (idOffset < 0) {
+            return null;
+        }
+
+        int sizeOffset = idOffset + elementId.length;
+        int sizeLength = vintLength(data, sizeOffset);
+        if (sizeLength < 1) {
+            return null;
+        }
+        long payloadLengthValue = decodeVint(data, sizeOffset, sizeLength, true);
+        if (payloadLengthValue < 1 || payloadLengthValue > 8) {
+            return null;
+        }
+
+        int payloadLength = (int) payloadLengthValue;
+        int payloadOffset = sizeOffset + sizeLength;
+        if (payloadOffset + payloadLength > data.length) {
+            return null;
+        }
+        return new UnsignedElement(
+                payloadOffset,
+                payloadLength,
+                decodeUnsigned(data, payloadOffset, payloadLength));
+    }
+
+    private static int vintLength(byte[] data, int offset) {
+        if (offset < 0 || offset >= data.length || data[offset] == 0) {
+            return -1;
+        }
+        int mask = 0x80;
+        for (int length = 1; length <= 8; length++) {
+            if ((data[offset] & mask) != 0) {
+                return offset + length <= data.length ? length : -1;
+            }
+            mask >>>= 1;
+        }
+        return -1;
+    }
+
+    private static long decodeVint(byte[] data, int offset, int length, boolean removeLengthMask) {
+        long value = data[offset] & 0xFFL;
+        if (removeLengthMask) {
+            value &= ~(0x80L >>> (length - 1));
+        }
+        for (int i = 1; i < length; i++) {
+            value = (value << 8) | (data[offset + i] & 0xFFL);
+        }
+        return value;
+    }
+
+    private static long decodeUnsigned(byte[] data, int offset, int length) {
+        long value = 0;
+        for (int i = 0; i < length; i++) {
+            value = (value << 8) | (data[offset + i] & 0xFFL);
+        }
+        return value;
+    }
+
+    private static boolean fitsUnsigned(long value, int byteCount) {
+        if (value < 0 || byteCount < 1 || byteCount > 8) {
+            return false;
+        }
+        return byteCount == 8 || value < (1L << (byteCount * 8));
+    }
+
+    private static byte[] encodeUnsigned(long value, int byteCount) {
+        byte[] result = new byte[byteCount];
+        for (int i = byteCount - 1; i >= 0; i--) {
+            result[i] = (byte) (value & 0xFF);
+            value >>>= 8;
+        }
+        return result;
+    }
+
+    private static void applyPatch(
+            byte[] buffer,
+            int bufferOffset,
+            int bytesRead,
+            long absoluteReadOffset,
+            long patchOffset,
+            @Nullable byte[] replacement) {
+        if (patchOffset < 0 || replacement == null || replacement.length == 0) {
+            return;
+        }
+
+        long readEnd = absoluteReadOffset + bytesRead;
+        long patchEnd = patchOffset + replacement.length;
+        long overlapStart = Math.max(absoluteReadOffset, patchOffset);
+        long overlapEnd = Math.min(readEnd, patchEnd);
+        if (overlapStart >= overlapEnd) {
+            return;
+        }
+
+        int sourceOffset = (int) (overlapStart - patchOffset);
+        int destinationOffset = bufferOffset + (int) (overlapStart - absoluteReadOffset);
+        int count = (int) (overlapEnd - overlapStart);
+        System.arraycopy(replacement, sourceOffset, buffer, destinationOffset, count);
+    }
+
+    private static int indexOf(byte[] data, byte[] pattern, int start, int end) {
+        int lastStart = Math.min(end, data.length) - pattern.length;
+        for (int i = Math.max(0, start); i <= lastStart; i++) {
+            boolean matches = true;
+            for (int j = 0; j < pattern.length; j++) {
+                if (data[i + j] != pattern[j]) {
+                    matches = false;
+                    break;
+                }
+            }
+            if (matches) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    private static boolean isMatroska(Uri uri) {
+        String path = uri.getPath();
+        return path != null && path.toLowerCase(Locale.US).endsWith(".mkv");
+    }
+
+    private static byte[] bytes(int... values) {
+        byte[] result = new byte[values.length];
+        for (int i = 0; i < values.length; i++) {
+            result[i] = (byte) values[i];
+        }
+        return result;
+    }
+
+    static final class Factory implements DataSource.Factory {
+        private final DataSource.Factory upstreamFactory;
+
+        Factory(DataSource.Factory upstreamFactory) {
+            this.upstreamFactory = upstreamFactory;
+        }
+
+        @Override
+        public DataSource createDataSource() {
+            return new ChainedMatroskaDataSource(upstreamFactory);
+        }
+    }
+
+    private static final class UnsignedElement {
+        final long payloadOffset;
+        final int payloadLength;
+        final long value;
+
+        UnsignedElement(long payloadOffset, int payloadLength, long value) {
+            this.payloadOffset = payloadOffset;
+            this.payloadLength = payloadLength;
+            this.value = value;
+        }
+    }
+
+    private static final class Patch {
+        final long seekIdOffset;
+        @Nullable final byte[] seekIdBytes;
+        final long seekPositionOffset;
+        @Nullable final byte[] seekPositionBytes;
+
+        Patch(
+                long seekIdOffset,
+                @Nullable byte[] seekIdBytes,
+                long seekPositionOffset,
+                @Nullable byte[] seekPositionBytes) {
+            this.seekIdOffset = seekIdOffset;
+            this.seekIdBytes = seekIdBytes == null ? null : Arrays.copyOf(seekIdBytes, seekIdBytes.length);
+            this.seekPositionOffset = seekPositionOffset;
+            this.seekPositionBytes = seekPositionBytes == null
+                    ? null
+                    : Arrays.copyOf(seekPositionBytes, seekPositionBytes.length);
+        }
+    }
+}
